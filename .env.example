# Application Configuration
APP_NAME="Medical Brain MRI Analysis API"
APP_ENV="development" # development, staging, production
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SUPER_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173","http://localhost:8080"]
RATE_LIMIT_PER_MINUTE=100

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=brain_mri_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brain_mri_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/brain_mri_db

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ML Model Configuration
MODEL_DIR=./models
MODEL_PATH=./models/brain_mri_resnet50_v1.pt
MODEL_VERSION=1.0.0
MODEL_DEVICE=cpu # cpu, cuda, or mps
CONFIDENCE_THRESHOLD=0.50
SUPPORTED_CLASSES=["no_tumor", "glioma", "meningioma", "pituitary"]

# Storage Configuration (local, s3, minio)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".dcm"]

# Google Gemini AI Assistant Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AWS S3 / MinIO Configuration (optional when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=medical-brain-mri-images
AWS_S3_ENDPOINT_URL= # e.g., http://localhost:9000 for MinIO

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=True
